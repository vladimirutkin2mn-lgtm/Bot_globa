# Staging runtime for the five live release gates in docs/runbooks/production-readiness.md.
# Copy to .env.staging on the staging host and fill it there. Never commit the filled file.
# Production credentials must never be copied into this environment.

APP_ENV=staging
LOG_LEVEL=INFO

# --- isolated database -----------------------------------------------------------
POSTGRES_DB=bot_globa_staging
POSTGRES_USER=bot_globa_staging
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://bot_globa_staging:CHANGE_ME@db:5432/bot_globa_staging

# --- separate staging Telegram bot ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://staging.example.invalid/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- staging-only encryption -----------------------------------------------------
CONTENT_ENCRYPTION_KEY=

# --- real model, staging key -----------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_INPUT_COST_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Keep birth-place lookup inside the service, matching current production behavior.
GEOCODING_PROVIDER=offline
GEOCODING_API_KEY=

# --- billing sandbox -------------------------------------------------------------
# The version-controlled staging.public.env enables both providers, subscriptions,
# recurring YooKassa and refunds. Credentials here must be sandbox/test credentials.
PAYMENT_PROVIDER=yookassa
PAYMENT_PUBLIC_BASE_URL=https://staging.example.invalid
PAYMENT_CURRENCY=RUB
PAYMENT_WEBHOOK_SECRET=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
YOOKASSA_TRUSTED_PROXY_ALLOWLIST=
YOOKASSA_RECEIPT_EMAIL=

# Release readiness rejects live Stripe credentials on staging. Use sk_test_ or rk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- observability / release operator -------------------------------------------
ADMIN_API_TOKEN=

# --- isolated Oracle controls ----------------------------------------------------
# Staging may exercise the real model, but it must have its own small spend envelope.
ORACLE_ROLLOUT_SEED=staging-release-gates
ORACLE_DAILY_SPEND_CAP_MICROUSD=0
ORACLE_MAX_RESERVED_COST_MICROUSD_PER_READING=0
