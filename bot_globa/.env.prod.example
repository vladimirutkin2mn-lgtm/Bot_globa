# Production environment for the shared single-host deployment.
# Copy to .env.prod on the server and fill in. Never commit the filled file.
#
# Everything that must change from a shipped default is enumerated in
# docs/runbooks/production-readiness.md at the repository root.
#
# `APP_ENV=production` makes the settings fail closed: the process refuses to start on a
# weak encryption key, a non-HTTPS payment URL, billing without a real provider, or an
# incomplete YooKassa configuration. An empty value below is not a placeholder you can
# leave — it is a boot failure.

APP_ENV=production
LOG_LEVEL=INFO

# --- database -------------------------------------------------------------------
# This stack runs its own PostgreSQL 17, matching the version CI tests against.
# To reuse another product's instance instead, point DATABASE_URL at it, create the
# database and role there, and delete the `db` service from docker-compose.prod.yml.
POSTGRES_DB=bot_globa
POSTGRES_USER=bot_globa
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://bot_globa:CHANGE_ME@db:5432/bot_globa

# --- telegram -------------------------------------------------------------------
# Its own bot, separate from any other product on this host.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://predict.mypresence.ru/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- encryption -----------------------------------------------------------------
# Production rejects a weak or malformed key. Generate 32+ random bytes.
CONTENT_ENCRYPTION_KEY=

# --- model ----------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=
# Required together: without both, the oracle daily spend cap cannot be computed.
LLM_INPUT_COST_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# --- birth-place lookup ---------------------------------------------------------
# `stub` resolves offline and makes no network call. `opencage` sends the user's place
# query to a third party — see bot_globa/docs/privacy-deletion-retention.md.
GEOCODING_PROVIDER=stub
GEOCODING_API_KEY=

# --- billing --------------------------------------------------------------------
# Billing on requires a real provider with complete credentials. With BILLING_ENABLED
# true and the values below empty the process will not start — that is deliberate.
BILLING_ENABLED=true
PAYMENT_PROVIDER=yookassa
PAYMENT_PUBLIC_BASE_URL=https://predict.mypresence.ru
PAYMENT_CURRENCY=RUB
PAYMENT_WEBHOOK_SECRET=

# This service shares a provider account with another product on this host. Its webhook
# endpoint is separate, and every checkout it creates carries a product marker so foreign
# events are dropped before the durable inbox.
YOOKASSA_ENABLED=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Required when YooKassa is on: the provider's published callback ranges.
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
YOOKASSA_RECEIPT_EMAIL=

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Each Stripe Price must be paired with its expected amount or the catalog refuses to load.
STRIPE_PRICE_READING_SINGLE_EUR=
STRIPE_AMOUNT_READING_SINGLE_EUR_MINOR=

SUBSCRIPTIONS_ENABLED=false
REFUNDS_ENABLED=false
YOOKASSA_RECURRING_ENABLED=false

# --- observability ---------------------------------------------------------------
ANALYTICS_BACKEND=postgres
ADMIN_METRICS_ENABLED=true
ADMIN_API_TOKEN=

# --- limited release --------------------------------------------------------------
# Start at 0 and raise once the process is observed healthy. The spend cap must
# upper-bound one generation plus the single allowed repair for the model above.
ORACLE_ENABLED=true
ORACLE_ROLLOUT_PERCENTAGE=0
ORACLE_ROLLOUT_SEED=
ORACLE_DAILY_SPEND_CAP_MICROUSD=0
ORACLE_MAX_RESERVED_COST_MICROUSD_PER_READING=0
