# Version-controlled non-secret switches for the isolated release-gate environment.
# This environment exists only to execute the five attestations required before limited
# production. Provider credentials remain in the server-side .env.staging file.
BILLING_ENABLED=true
BILLING_KILL_SWITCH=false
STRIPE_ENABLED=true
YOOKASSA_ENABLED=true
SUBSCRIPTIONS_ENABLED=true
REFUNDS_ENABLED=true
YOOKASSA_RECURRING_ENABLED=true
YOOKASSA_RECEIPTS_REQUIRED=true
TELEGRAM_STARS_ENABLED=false
ANALYTICS_BACKEND=postgres
ADMIN_METRICS_ENABLED=true
ORACLE_ENABLED=true
ORACLE_ROLLOUT_PERCENTAGE=100
