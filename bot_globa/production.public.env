# Version-controlled, non-secret production switches. This file is loaded after
# .env.prod so approved commercial configuration reaches every application process.
BILLING_KILL_SWITCH=false

# TEMPORARY PAYMENT SMOKE-TEST PRICES.
# Keep every production payment route at its minimum practical test value until checkout
# verification is complete. Revert this block to restore commercial pricing.
PRODUCT_READING_SINGLE_PRICE_MINOR=100
PRODUCT_READING_PACK_5_PRICE_MINOR=100
PRODUCT_SUBSCRIPTION_MONTHLY_PRICE_MINOR=100
STRIPE_AMOUNT_READING_SINGLE_EUR_MINOR=100
STRIPE_AMOUNT_READING_SINGLE_USD_MINOR=100
STRIPE_AMOUNT_READING_PACK_5_EUR_MINOR=100
STRIPE_AMOUNT_READING_PACK_5_USD_MINOR=100
STRIPE_AMOUNT_SUBSCRIPTION_MONTHLY_EUR_MINOR=100
STRIPE_AMOUNT_SUBSCRIPTION_MONTHLY_USD_MINOR=100

# Hosted provider webhooks are the fast path. Poll still-open orders every minute so a
# transient webhook/proxy/deploy interruption cannot leave a successful payment invisible
# to the user for 15–30 minutes.
BILLING_RECONCILIATION_INTERVAL_SECONDS=60
BILLING_PENDING_RECONCILIATION_SECONDS=60

TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_AMOUNT_READING_SINGLE=1
TELEGRAM_STARS_AMOUNT_READING_PACK_5=1
TELEGRAM_STARS_AMOUNT_SUBSCRIPTION_MONTHLY=1
SUBSCRIPTIONS_ENABLED=true
